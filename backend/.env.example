# ============================================
# 服务器环境变量配置
# ============================================

# MongoDB 数据库连接字符串
MONGODB_URI=mongodb://localhost:27017/couple-app

# JWT 密钥（用于用户认证，必须设置强密码）
JWT_SECRET=your-super-secret-jwt-key-here

# 服务器端口
PORT=3000

# WebSocket 端口
WS_PORT=3001

# ============================================
# Web Push 通知配置（可选）
# ============================================
# 使用以下命令生成密钥对：
# npx web-push generate-vapid-keys
#
# VAPID 公钥（给前端使用）
VAPID_PUBLIC_KEY=BD21mnBYXEjhCtTn_DlP7jWceQNyUpBvMWxNR6tfn79jxxZOR8cI-B5TkWEWAJXIVcLKcZRlU-PfHBkxEmPFh_U

# VAPID 私钥（仅后端使用，保密！）
VAPID_PRIVATE_KEY=your-private-key-here

# 联系邮箱（推送服务需要）
VAPID_SUBJECT=mailto:your-email@example.com

# ============================================
# AI 配置（可选）
# ============================================
# Moonshot AI (Kimi) API Key
# 获取地址：https://platform.moonshot.cn/
MOONSHOT_API_KEY=your-moonshot-api-key-here

# 启用 AI 数据收集（默认关闭）
# 设置为 true 后，每日凌晨 2 点会自动导出用户数据到 S3
ENABLE_AI_DATA_COLLECTION=false

# ============================================
# 文件存储配置（可选）
# ============================================
# 本地模式：文件存储在服务器本地
# S3 模式：文件存储在对象存储（如雨云）
STORAGE_MODE=local

# 雨云对象存储配置（STORAGE_MODE=s3 时使用）
S3_ENDPOINT=https://s3.example.com
S3_REGION=cn-north-1
S3_BUCKET=your-bucket
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key

# ============================================
# 数据库备份配置（可选，建议生产环境开启）
# ============================================
# 本地备份存放目录（绝对路径，默认 backend/backups）
BACKUP_DIR=/www/wwwroot/couple-website/backups

# 备份保留天数（默认 30 天，超期自动删除）
BACKUP_RETENTION_DAYS=30
