# ============================================
# Fellow（共赴）后端环境变量配置示例
# 复制本文件为 .env 并按需填写即可启动
# ============================================

# --------------------------------------------
# 核心配置（必填）
# --------------------------------------------

# Node.js 运行环境
NODE_ENV=development

# MongoDB 数据库连接字符串
# 本地开发示例：mongodb://localhost:27017/fellow
# MongoDB Atlas 示例：mongodb+srv://user:pass@cluster.mongodb.net/fellow?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/fellow

# JWT 签名密钥（生产环境务必设置高强度随机字符串）
# 可使用：node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars

# JWT 有效期（默认 7d）
JWT_EXPIRES=7d

# 允许跨域访问的前端 Origin，多个地址使用英文逗号分隔
# 同源部署可留空；本地开发会自动允许 localhost:5173
CORS_ORIGINS=

# Nginx 等反向代理层数；本地直连使用 0，生产环境按实际代理层数设置
TRUST_PROXY_HOPS=0

# 服务器 HTTP 端口
PORT=3000

# WebSocket 实时通信端口
WS_PORT=3001

# --------------------------------------------
# Web Push 浏览器推送通知（可选）
# --------------------------------------------
# 如果不配置，PWA 离线推送功能将不可用，但其他功能正常
#
# 1. 安装 web-push：npm install -g web-push
# 2. 生成密钥对：npx web-push generate-vapid-keys
# 3. 将生成的公钥和私钥填入下方

# VAPID 公钥（前端也需要此值，会通过 /api/config 接口自动下发）
VAPID_PUBLIC_KEY=your-vapid-public-key

# VAPID 私钥（仅后端使用，切勿泄露或提交到 Git）
VAPID_PRIVATE_KEY=your-vapid-private-key

# 联系邮箱（推送服务要求，格式必须为 mailto:xxx）
VAPID_SUBJECT=mailto:your-email@example.com

# --------------------------------------------
# AI 助手配置（可选）
# --------------------------------------------
# 基于 Moonshot AI（Kimi）提供习惯分析、计划优化等功能
# 获取 API Key：https://platform.moonshot.cn/

MOONSHOT_API_KEY=your-moonshot-api-key

# 是否启用 AI 数据收集（默认关闭）
# 开启后每日凌晨 2 点自动导出数据到 S3 供 AI 分析
ENABLE_AI_DATA_COLLECTION=false

# --------------------------------------------
# 文件存储配置（可选）
# --------------------------------------------
# 支持两种模式：
# - local：文件存储在服务器本地 backend/uploads/（适合开发/小规模）
# - s3：文件存储在 S3 兼容对象存储（适合生产环境）

STORAGE_MODE=local

# S3 兼容存储配置（STORAGE_MODE=s3 时必填）
# 支持 AWS S3、雨云、MinIO、阿里云 OSS 等
S3_ENDPOINT=https://s3.example.com
S3_REGION=cn-north-1
S3_BUCKET=your-bucket-name
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key

# 服务器公网地址（用于生成图片预签名 URL）
# 示例：https://your-domain.com 或 http://192.168.1.100:3000
BASE_URL=

# --------------------------------------------
# 数据库自动备份（可选，建议生产环境开启）
# --------------------------------------------

# 本地备份存放目录（绝对路径，留空则默认 backend/backups）
BACKUP_DIR=

# 备份保留天数（超期自动清理，默认 30 天）
BACKUP_RETENTION_DAYS=30
