# 环境变量配置文件
# 复制此文件为 .env 并修改配置
# cp .env.example .env

# MongoDB连接字符串
# 本地开发：mongodb://localhost:27017/couple_db
# 服务器（有认证）：mongodb://用户名:密码@localhost:27017/couple_db?authSource=admin
MONGODB_URI=mongodb://localhost:27017/couple_db

# 服务器端口
PORT=3000

# WebSocket端口
WS_PORT=3001

# JWT密钥（生产环境请使用强密码）
JWT_SECRET=your-secret-key-here

# 环境标识
development
