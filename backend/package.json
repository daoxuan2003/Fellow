{
  "name": "couple-website",
  "version": "1.0.0",
  "description": "情侣双人私密网站",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "backup": "node scripts/backup-db.js",
    "check": "node scripts/check-syntax.js",
    "test": "node --test tests/*.test.js",
    "audit": "npm audit --omit=dev --audit-level=high",
    "verify": "npm run check && npm test && npm run audit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.989.0",
    "@aws-sdk/s3-request-presigner": "^3.989.0",
    "axios": "^1.8.4",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.5.2",
    "file-type": "^21.3.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^7.5.0",
    "multer": "^2.0.2",
    "node-cron": "^4.5.0",
    "web-push": "^3.6.7",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "database-observer-ip-address": "npm:ip-address@10.2.0",
    "database-observer-mongoose": "npm:mongoose@7.8.9",
    "nodemon": "^3.0.1"
  }
}
