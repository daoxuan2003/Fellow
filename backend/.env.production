# 生产环境配置（服务器用）
# 这个文件仅供参考，实际部署时应在服务器上创建 .env 文件

# MongoDB连接字符串（带认证）
# 生产环境需使用支持事务的副本集、分片集群或 MongoDB Atlas
MONGODB_URI=mongodb://couple:你的密码@localhost:27017/couple_db?authSource=admin

# 服务器端口
PORT=3000

# WebSocket端口
WS_PORT=3001

# JWT密钥（生产环境请使用强密码）
JWT_SECRET=your-production-secret-key-min-32-characters

# 环境标识
NODE_ENV=production
